# Token del bot de Discord (crea el bot en https://discord.com/developers/applications)
# y activa el intent privilegiado "Message Content" en la pestaña Bot.
DISCORD_TOKEN=tu_token_aqui

# Servidor donde registrar los slash commands al arrancar (aparecen al instante).
# Sin él se registran globales y pueden tardar hasta 1 hora en aparecer.
# Para ver el ID: Ajustes del servidor -> General -> ID del servidor
# (activa el Modo desarrollador en Ajustes de usuario -> Avanzado).
GUILD_ID=
